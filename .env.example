# Copy to .env and adjust. docker compose reads it automatically.
# Every value here is the default; delete a line to fall back to it.

# --- Data source (the relay, `wifi-sim`) ---
# Where the relay reads the BMS `#mLive` serial line from:
#   tcp://firmware-rig:3333        the firmware rig (default, real firmware on a simulated battery)
#   http://bms-simulator:8000/live pure-Python simulator (also start with: docker compose --profile sim up)
#   serial:COM5                    a real BMS C1 on a USB-serial adapter (Linux: serial:/dev/ttyUSB0)
#   file:/path/to/pty              a pseudo-terminal or file (Linux/WSL only)
# A serial: source needs the port passed into the container; on Windows run the relay on the host instead.
RELAY_SOURCE=tcp://firmware-rig:3333

# --- Device identity and sizing (shared by the rig and the relay) ---
# Used in every MQTT topic: bms/<DEVICE_ID>/...
DEVICE_ID=haske-bms-001
# Real seconds between measurements published by the relay
PUBLISH_INTERVAL_S=5
# Battery pack size, used by the rig's battery model and reported as capacity
CAPACITY_AH=50
# Number of cells in series (rig only)
CELLS=8

# --- Firmware rig (the real firmware on a simulated battery) ---
# Firmware time vs real time. 1 = a real device (the state of charge is initialised from the cells at boot).
# Above 1 the battery ages faster, but SoC starts at 0 until the firmware's first full-charge reset.
# Also sets the bridge TIME_SCALE. Use 1 with a real BMS.
SPEED=60
# normal | charging | discharging | low_soc | cell_drift | overheat | cloudy | overcurrent | undervoltage | instant_recovery   (can also be switched live: POST /scenario/<name>)
SCENARIO=normal

# --- BMS bridge ---
# Real seconds between summaries (900 = 15 min in production; short here so demos are lively).
# Faults and health changes are always reported immediately.
SUMMARY_INTERVAL_S=30

# --- MicroPowerManager (mpm-ingestor) ---
# Create the key in MPM: Settings > API keys. Never commit the real key.
MPM_BASE_URL=http://host.docker.internal:8000
MPM_API_KEY=

# --- MicroPowerManager (only with: docker compose --profile mpm up --build -d) ---
# Demo defaults; change them if the stack is reachable by anyone else.
# Owner login created in MPM on first start (http://localhost:8001)
MPM_OWNER_EMAIL=owner@example.com
MPM_OWNER_PASSWORD=demo-password-1
# MySQL root password used by the MPM containers
MPM_DB_PASSWORD=mpm-demo-db-password
# Upstream MPM commit to build (a full 40-character commit hash)
MPM_REF=d6632495586a9dc5c4f71decdec33f5f960701b8
