# Copy to .env and adjust. docker compose reads it automatically.

# --- MQTT broker ---
MQTT_HOST=mosquitto
MQTT_PORT=1883

# --- Firmware rig (the real firmware on a simulated battery) ---
DEVICE_ID=haske-bms-001
# Real seconds between published measurements
PUBLISH_INTERVAL_S=5
# Firmware time vs real time. 1 = a real device (the state of charge is initialised from the cells at boot).
# Above 1 the battery ages faster, but SoC starts at 0 until the firmware's first full-charge reset.
# Also sets the bridge TIME_SCALE.
SPEED=1
# normal | cell_drift | overheat   (can also be switched live: POST /scenario/<name>)
SCENARIO=normal

# --- BMS bridge ---
# Real seconds between summaries (900 = 15 min in production; short here so demos are lively).
# Faults and health changes are always reported immediately.
SUMMARY_INTERVAL_S=30

# MicroPowerManager (mpm-ingestor). Create the key in MPM: Settings > API keys.
MPM_BASE_URL=http://host.docker.internal:8000
MPM_API_KEY=
